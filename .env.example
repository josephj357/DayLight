# DayLight environment configuration.
# Copy to `.env` and fill in. Never commit the real .env.

# --- Federal data ---

# FEC OpenFEC API. Free.
# Get one at: https://api.open.fec.gov/developers/
FEC_API_KEY=

# Congress.gov API (Library of Congress). Free.
# Replaces the discontinued ProPublica Congress API (shut down 2024-07-10).
# Get one at: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# --- Lobbying disclosure ---

# Senate LDA API. Free, requires registration.
# Get one at: https://lda.senate.gov/api/register/
SENATE_LDA_API_KEY=

# --- AI synthesis ---

# Anthropic API key for the plain-English synthesis layer.
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use for synthesis. Pinned per ADR-005 so output is reproducible.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Application ---

# Where the backend FastAPI process listens.
DAYLIGHT_API_HOST=127.0.0.1
DAYLIGHT_API_PORT=8000

# Where the frontend should call the backend from. Used at build time by Next.js.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Path to the SQLite database file. Relative to repo root.
DAYLIGHT_DB_PATH=data/daylight.db

# --- OpenSecrets ---
# No API key — the OpenSecrets API was discontinued 2025-04-15.
# Bulk data is downloaded manually. See /docs/data-sources.md.
# License: CC BY-NC-SA 3.0 US — attribute and never use commercially without
# a separate agreement with OpenSecrets.
